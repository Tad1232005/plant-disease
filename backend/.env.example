PROJECT_NAME="Plant Disease API"
# Một bộ POSTGRES_* dùng chung cho FastAPI, Docker Compose và pgAdmin Desktop.
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=plant_disease
POSTGRES_USER=plant_app
POSTGRES_PASSWORD=plant_dev_password
POSTGRES_PORT=55432
API_V1_STR="/api/v1"
SECRET_KEY=change-this-secret-key-in-production     # bash python -c "import secrets; print(secrets.token_hex(32))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MODEL_ARTIFACT_ROOT=app/ml_assets/models
CONFIDENCE_THRESHOLD=0.3
TOP1_MARGIN_THRESHOLD=0.05
JS_DIVERGENCE_THRESHOLD=0.3
PARALLEL_MODEL_INFERENCE=true
MAX_CONCURRENT_INFERENCES=1
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
INFERENCE_TIMEOUT_SECONDS=30
UPLOAD_DIR=storage/uploads
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
